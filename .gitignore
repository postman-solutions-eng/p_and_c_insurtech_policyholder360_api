# Java — from github/gitignore@356fd7baab4c05e092194a41f64dbd5afc8817e4
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# --- Local environment files (PM_GH_REPO_005) ---
# Ignore every .env variant; keep the committed example so contributors know the shape.
.env
.env.*
!.env.example
